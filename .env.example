# Database Connection (SQLite out of the box, zero configuration needed)
DATABASE_URL="file:./dev.db"

# JWT Secret for Protected Admin Authentication (Generate using: openssl rand -base64 48)
JWT_SECRET="generate-a-strong-random-secret-key-for-production-min-32-chars"

# Public Site URL
NEXT_PUBLIC_SITE_URL="https://lumiere-studio.com"

# Optional Initial Admin Credentials (defaults to admin@lumiere.com / admin123 if omitted)
INITIAL_ADMIN_EMAIL="admin@lumiere.com"
INITIAL_ADMIN_PASSWORD="ChooseAStrongPassphrase2026!"
